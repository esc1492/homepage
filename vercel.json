{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/album", "destination": "/album/index" },
    { "source": "/album/:path*", "destination": "/album/index" },
    { "source": "/tetris", "destination": "/tetris/index" },
    { "source": "/tetris/:path*", "destination": "/tetris/index" },
    { "source": "/arkanoid", "destination": "/arkanoid/index" },
    { "source": "/arkanoid/:path*", "destination": "/arkanoid/index" }
  ]
}
